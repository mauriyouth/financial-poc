.PHONY: api worker test lint fix format format-check precommit install-hooks local-stack local-dev stack-down stack-clean

# Services
api:
	uv run uvicorn src.api.main:app --reload --host 0.0.0.0 --port 8000

worker:
	uv run python worker.py

local-stack:
	cd ../infra/local-stack && docker-compose up -d

local-dev:
	cd ../infra/local-stack && docker-compose up -d
	make api

stack-down:
	cd ../infra/local-stack && docker-compose down

stack-clean:
	cd ../infra/local-stack && docker-compose down -v

# Testing
test:
	uv run pytest -v

test-cov:
	uv run pytest -v --cov=src --cov-report=term-missing --cov-report=html

# Linting and Formatting
lint:
	uv run ruff check .

fix:
	uv run ruff check --fix .

format:
	uv run ruff format .

format-check:
	uv run ruff format --check .

# Pre-commit quality checks
precommit: lint format-check test
	@echo "✓ All quality checks passed!"

# Install pre-commit hooks
install-hooks:
	uv run pre-commit install
	@echo "✓ Pre-commit hooks installed!"
