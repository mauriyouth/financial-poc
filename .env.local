# --- Database (PostgreSQL) ---
POSTGRES_USER=user
POSTGRES_DB=ufdip
# Internal K8s service: <service-name>.<namespace>.svc.cluster.local
POSTGRES_HOST=managed-services-postgresql.managed-services.svc.cluster.local
POSTGRES_PORT=5432

# --- Cache (Valkey/Redis) ---
REDIS_HOST=managed-services-valkey.managed-services.svc.cluster.local
REDIS_PORT=6379
REDIS_DB=0

# --- Storage (MinIO) ---
MINIO_ENDPOINT=managed-services-minio.managed-services.svc.cluster.local:9000
MINIO_BUCKET=financial-poc
MINIO_SECURE=False

# --- Search (OpenSearch) ---
OPENSEARCH_HOST=opensearch-cluster-master.managed-services.svc.cluster.local
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_USE_SSL=False
OPENSEARCH_VERIFY_CERTS=False

# --- AI Settings ---
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GEMINI_MODEL=gemini-3-pro-preview

ANTHROPIC_MAX_TOKENS=4096
ADK_DEFAULT_MODEL=gemini-3-pro-preview
ADK_DEFAULT_TEMPERATURE=0.1

# --- Frontend ---
# Internal API URL for server-side calls
NEXT_PUBLIC_API_URL=http://financial-poc-api:8000
